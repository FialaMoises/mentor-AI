# Copie para .env e ajuste. O .env nunca é versionado.

POSTGRES_USER=mentor
POSTGRES_PASSWORD=mentor
POSTGRES_DB=mentor
# Porta do host para o Postgres do compose (o 5432 costuma estar ocupado por um Postgres local).
POSTGRES_HOST_PORT=5433

# Usada pela API e pelas migrations.
DATABASE_URL=postgresql+psycopg://mentor:mentor@localhost:5432/mentor

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:4200

# Parâmetros de calibração do motor (spec: k perto de 10, revisões em 1, 7 e 30 dias).
ENGINE_K=10
ENGINE_REVIEW_OFFSETS_DAYS=1,7,30
ENGINE_INACTIVITY_DAYS=5
