# Copie para .env e ajuste. O .env nunca é versionado.

POSTGRES_USER=mentor
POSTGRES_PASSWORD=mentor
POSTGRES_DB=mentor
# Porta do host para o Postgres do compose (o 5432 costuma estar ocupado por um Postgres local).
POSTGRES_HOST_PORT=5433

# Usada pela API e pelas migrations.
DATABASE_URL=postgresql+psycopg://mentor:mentor@localhost:5432/mentor

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:4200

# Parâmetros de calibração do motor (spec: k perto de 10, revisões em 1, 7 e 30 dias).
ENGINE_K=10
ENGINE_REVIEW_OFFSETS_DAYS=1,7,30
ENGINE_INACTIVITY_DAYS=5

# Object store. Em dev, o MinIO do compose; em produção, S3 de verdade
# (deixe S3_ENDPOINT_URL vazio e use as credenciais da AWS).
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=mentor-ai-uploads
S3_ACCESS_KEY=mentor
S3_SECRET_KEY=mentor123
S3_REGION=us-east-1

# Extração dos arquivos de rotina. Sem chave, a API usa o dublê e não chama
# nenhum serviço externo — útil para desenvolver sem gastar crédito.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-4-5

# Web Push. Gere o par com: python -m app.tools.vapid
# Sem VAPID_PRIVATE_KEY a API não envia push nenhum (e não quebra por isso).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@mentor-ai.app

# E-mail de reserva, para quem não tem push (iPhone sem app instalado).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=mentor-AI <nao-responda@mentor-ai.app>
